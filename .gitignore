# --- Terraform -------------------------------------------------------------
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
**/backend.hcl
*.tfplan
plan.out

# --- Cloud / cluster credentials -------------------------------------------
kubeconfig
*.kubeconfig
.kube/
*.pem
*.key
*-key.json
key.json
.credentials/
gcloud/

# --- Charts (pinned by CHART.lock, downloaded not committed) ----------------
apps/otel-demo/charts/

# --- Python (aiops service) -------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Secrets / local env ----------------------------------------------------
.env
.env.*
!.env.example

# --- Local output (may contain cluster data; never commit) ------------------
/out/
/tmp/
*.log

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
